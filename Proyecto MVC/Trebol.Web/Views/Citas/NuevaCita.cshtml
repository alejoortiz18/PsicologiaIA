@model Trebol.Model.DTOs.Cita.CrearCitaDto
@{
    ViewData["Title"] = "Agendar Cita";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin-bottom:var(--sp-6);">📅 Agendar nueva cita</h1>

<div style="max-width:520px;">
    <div class="card">
        <div style="padding:var(--sp-6);">
            <form asp-action="NuevaCita" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="form-error" style="margin-bottom:var(--sp-4);"></div>
                <input type="hidden" asp-for="ProfesionalId" />

                <div class="form-group">
                    <label asp-for="FechaHora" class="form-label">Fecha y hora</label>
                    <input asp-for="FechaHora" type="datetime-local" class="form-control" />
                    <span asp-validation-for="FechaHora" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DuracionMinutos" class="form-label">Duración</label>
                    <select asp-for="DuracionMinutos" class="form-control">
                        <option value="30">30 minutos</option>
                        <option value="45">45 minutos</option>
                        <option value="60">60 minutos</option>
                        <option value="90">90 minutos</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Tipo" class="form-label">Tipo de cita</label>
                    <select asp-for="Tipo" class="form-control">
                        <option value="0">Virtual</option>
                        <option value="1">Presencial</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Notas" class="form-label">Notas (opcional)</label>
                    <textarea asp-for="Notas" class="form-control" rows="3" placeholder="Motivo o comentario..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-full">Agendar cita</button>
            </form>
        </div>
    </div>
</div>
