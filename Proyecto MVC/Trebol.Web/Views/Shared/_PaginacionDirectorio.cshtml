@model Trebol.Model.DTOs.Common.PaginacionVm
@using Trebol.Constants.Pagination
@{
    var controller = Model.Controller ?? ViewContext.RouteData.Values["controller"]?.ToString() ?? "Directorio";
    var action = Model.Action ?? ViewContext.RouteData.Values["action"]?.ToString() ?? "Medicos";
    var query = Context.Request.Query
        .Where(q => !string.Equals(q.Key, "Pagina", StringComparison.OrdinalIgnoreCase)
                 && !string.Equals(q.Key, "pagina", StringComparison.OrdinalIgnoreCase))
        .Select(q => $"{q.Key}={Uri.EscapeDataString(q.Value.ToString())}");
    var qs = string.Join("&", query);
    var baseUrl = Url.Action(action, controller) + (string.IsNullOrEmpty(qs) ? "?" : "?" + qs + "&");
    var tamActual = Model.TamanoPagina;
    var paginacionDeshabilitada = Model.TotalRegistros <= 0;
}

<div class="directorio-pagination-bar" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--sp-4);margin-top:var(--sp-5);padding:var(--sp-4) var(--sp-5);background:var(--color-surface);border:1px solid var(--color-border-light);border-radius:var(--radius-xl);@(paginacionDeshabilitada ? "opacity:.65;" : "")">
    <span class="pagination-info" style="font-size:.8125rem;color:var(--color-text-muted);">
        Mostrando @Model.Desde–@Model.Hasta de @Model.TotalRegistros registros
    </span>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="pagination" aria-label="Paginación" style="display:flex;gap:var(--sp-1);">
            @{
                var prev = Math.Max(1, Model.PaginaActual - 1);
                var next = Math.Min(Model.TotalPaginas, Model.PaginaActual + 1);
            }
            <a href="@(baseUrl)Pagina=@prev" class="pagination__btn @(Model.PaginaActual <= 1 ? "disabled" : "")" aria-label="Página anterior">‹</a>
            @for (var p = 1; p <= Model.TotalPaginas; p++)
            {
                if (p == 1 || p == Model.TotalPaginas || Math.Abs(p - Model.PaginaActual) <= 1)
                {
                    <a href="@(baseUrl)Pagina=@p" class="pagination__btn @(p == Model.PaginaActual ? "active" : "")">@p</a>
                }
                else if (p == 2 && Model.PaginaActual > 3)
                {
                    <span class="pagination__btn" style="cursor:default;border:none;">...</span>
                }
                else if (p == Model.TotalPaginas - 1 && Model.PaginaActual < Model.TotalPaginas - 2)
                {
                    <span class="pagination__btn" style="cursor:default;border:none;">...</span>
                }
            }
            <a href="@(baseUrl)Pagina=@next" class="pagination__btn @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")" aria-label="Página siguiente">›</a>
        </nav>
    }

    <form method="get" asp-controller="@controller" asp-action="@action" class="directorio-page-size" style="display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;margin-left:auto;">
        @if (!string.IsNullOrEmpty(Context.Request.Query["Especialidad"]))
        {
            <input type="hidden" name="Especialidad" value="@Context.Request.Query["Especialidad"]" />
        }
        @if (!string.IsNullOrEmpty(Context.Request.Query["Ciudad"]))
        {
            <input type="hidden" name="Ciudad" value="@Context.Request.Query["Ciudad"]" />
        }
        <label for="page-size" class="text-meta" style="margin:0;white-space:nowrap;">Registros por página:</label>
        <select id="page-size" name="TamanioPagina" class="form-control" style="max-width:88px;" onchange="this.form.submit()" @(paginacionDeshabilitada ? "disabled" : null)>
            @foreach (var n in PaginacionConstant.OpcionesDirectorio)
            {
                <option value="@n" selected="@(n == tamActual)">@n</option>
            }
        </select>
        <input type="hidden" name="Pagina" value="1" />
    </form>
</div>
