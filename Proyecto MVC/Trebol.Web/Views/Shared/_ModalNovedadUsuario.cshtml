@using Trebol.Constants.Messages
<div id="novedad-usuario-backdrop" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="novedad-usuario-title" aria-hidden="true">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-icon warning" aria-hidden="true">🔔</div>
            <div>
                <div class="modal-title" id="novedad-usuario-title">Novedad pendiente</div>
                <div class="modal-subtitle" id="novedad-usuario-subtitle">Requiere tu decisión</div>
            </div>
            <button type="button" class="modal-close" data-close-modal="novedad-usuario" aria-label="Cerrar">✕</button>
        </div>
        <div class="modal-body">
            <div id="novedad-usuario-aviso" class="card" hidden
                 style="margin-bottom:var(--sp-4);padding:var(--sp-4);background:var(--color-surface-alt);border:1px solid var(--color-border-light);">
                <p style="margin:0;font-size:0.875rem;color:var(--color-text-secondary);">@NovedadConstant.AvisoEventoEnVivoPago</p>
            </div>
            <p id="novedad-usuario-mensaje" style="margin:0;color:var(--color-text-secondary);"></p>
            <div id="novedad-usuario-opciones" class="mis-saldos-novedad-opciones" style="margin-top:var(--sp-5);display:flex;flex-direction:column;gap:var(--sp-3);"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-close-modal="novedad-usuario">Cerrar</button>
        </div>
    </div>
</div>
