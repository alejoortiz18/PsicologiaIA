@model Trebol.Model.DTOs.Publico.EventoPublicoDto
@{
    var cultura = new System.Globalization.CultureInfo("es-CO");
    var esHoy = Model.FechaInicio.HasValue && Model.FechaInicio.Value.Date == DateTime.Today;
    var enVivoHoy = esHoy && Model.Estado == "Abierta";
    var precioTxt = Model.Precio <= 0 ? "Entrada libre" : Model.Precio.ToString("C0", cultura);
    var cuposRestantes = Math.Max(0, Model.Capacidad - Model.TotalInscritos);
    var pocosCupos = !Model.EsInscrito && cuposRestantes > 0 && cuposRestantes <= 10;
    var gradients = new[]
    {
        "linear-gradient(135deg,#1A3C34,#2D6A4F)",
        "linear-gradient(135deg,#1565C0,#1976D2)",
        "linear-gradient(135deg,#6A1B4D,#8B2252)",
        "linear-gradient(135deg,#4A148C,#6A1B9A)"
    };
    var bannerBg = gradients[Model.SalaId % gradients.Length];
    var badgeClass = enVivoHoy ? "badge-success" : (pocosCupos ? "badge-muted" : "badge-success");
    var badgeText = enVivoHoy ? "En vivo hoy" : (pocosCupos ? "Cerrada pronto" : "Abierta");
    var iniciales = string.Join("", (Model.NombreProfesional ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var regClass = Model.EsInscrito ? "btn btn-secondary btn-sm btn-reg-sala is-inscrito" : (pocosCupos ? "btn btn-danger btn-sm btn-reg-sala" : "btn btn-primary btn-sm btn-reg-sala");
    var regText = Model.EsInscrito ? "✓ Inscrito" : (pocosCupos ? "¡Últimos cupos!" : "Registrarse");
}
<article class="room-card" aria-label="Sala: @Model.Titulo"
         data-sala-id="@Model.SalaId"
         data-sala-titulo="@Model.Titulo"
         data-profesional-id="@Model.ProfesionalId"
         data-inscrito="@(Model.EsInscrito ? "1" : "0")">
    <div class="room-card__banner" style="background:@bannerBg;">
        <div class="room-card__banner-text">@Model.Titulo</div>
        <div class="room-card__badge">
            <span class="badge @badgeClass">
                @if (enVivoHoy || !pocosCupos) { <span class="badge-dot" aria-hidden="true"></span> }
                @badgeText
            </span>
        </div>
    </div>
    <div class="room-card__body">
        <div class="room-card__speaker">🎓 @Model.NombreProfesional</div>
        <div class="room-card__meta">
            @if (Model.FechaInicio.HasValue)
            {
                <span class="room-card__meta-item">📅 @Model.FechaInicio.Value.ToString("d MMM yyyy", cultura)</span>
                <span class="room-card__meta-item">🕐 @Model.FechaInicio.Value.ToString("h:mm tt", cultura)</span>
            }
            <span class="room-card__meta-item">👥 @Model.TotalInscritos/@Model.Capacidad</span>
        </div>
        <div class="d-flex items-center justify-between">
            <span class="room-card__price @(Model.Precio <= 0 ? "free" : "")">@precioTxt</span>
            <span class="text-meta" style="@(pocosCupos ? "color:var(--color-danger);font-weight:600;" : "")">
                @(cuposRestantes == 0 ? "Sin cupos" : $"{cuposRestantes} cupo{(cuposRestantes == 1 ? "" : "s")}")
            </span>
        </div>
    </div>
    <div class="room-card__footer room-card__footer--actions">
        <button type="button" class="btn btn-secondary btn-sm btn-ver-sala" data-sala-id="@Model.SalaId">Ver más</button>
        <button type="button" class="@regClass" data-sala-id="@Model.SalaId" data-sala-titulo="@Model.Titulo"
                @(Model.EsInscrito ? "disabled" : null)>@regText</button>
        <button type="button" class="btn btn-ghost btn-sm btn-like-sala @(Model.EsSeguido ? "is-liked" : "")"
                data-liked="@(Model.EsSeguido ? "true" : "false")"
                data-profesional-id="@Model.ProfesionalId"
                aria-label="Me gusta">
            @(Model.EsSeguido ? "💚" : "🤍") <span class="like-count">@Model.TotalSeguidos</span>
        </button>
        <button type="button" class="btn btn-ghost btn-sm"
                data-pm-name="@Model.NombreProfesional"
                data-pm-avatar="@iniciales"
                data-pm-profesional-id="@Model.ProfesionalId"
                data-pm-bg="@bannerBg"
                aria-label="Mensaje a @Model.NombreProfesional">Mensaje</button>
    </div>
</article>
