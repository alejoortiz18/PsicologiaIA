@model IReadOnlyList<Trebol.Model.DTOs.Publico.EventoPublicoDto>
@{
    var eventos = Model ?? [];
    var hoy = eventos.Where(e => e.FechaInicio?.Date == DateTime.Today).ToList();
    var semana = eventos.Where(e =>
        e.FechaInicio.HasValue
        && e.FechaInicio.Value.Date > DateTime.Today
        && e.FechaInicio.Value.Date <= DateTime.Today.AddDays(7)).ToList();
    var proximos = eventos
        .Where(e => !hoy.Contains(e) && !semana.Contains(e))
        .ToList();
}
<div style="background:var(--color-surface);border:1px solid var(--color-border-light);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-sm);">
    @if (!eventos.Any())
    {
        <div style="padding:var(--sp-8);text-align:center;color:var(--color-text-muted);">
            <p style="margin:0 0 var(--sp-2);">Aún no tienes eventos de tus mentores.</p>
            <p style="margin:0;font-size:.875rem;">Cuando tengas o hayas tenido <strong>acompañamiento</strong> (citas de seguimiento, no asesoría puntual) con un profesional, aquí verás sus salas y conferencias vigentes.</p>
        </div>
    }
    else
    {
        @if (hoy.Any())
        {
            <div style="padding:var(--sp-2) var(--sp-5);background:rgba(229,57,53,.06);border-bottom:1px solid rgba(229,57,53,.15);">
                <span style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--color-danger);">🔴 Hoy</span>
            </div>
            @foreach (var ev in hoy)
            {
                @await Html.PartialAsync("_EventoPublicoItem", ev)
            }
        }
        @if (semana.Any())
        {
            <div style="padding:var(--sp-2) var(--sp-5);background:rgba(82,183,136,.06);border-top:1px solid var(--color-border-light);border-bottom:1px solid rgba(82,183,136,.2);">
                <span style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#2D6A4F;">📅 Esta semana</span>
            </div>
            @foreach (var ev in semana)
            {
                @await Html.PartialAsync("_EventoPublicoItem", ev)
            }
        }
        @if (proximos.Any())
        {
            <div style="padding:var(--sp-2) var(--sp-5);background:var(--color-surface-alt);border-top:1px solid var(--color-border-light);border-bottom:1px solid var(--color-border-light);">
                <span style="font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--color-text-muted);">🗓 Próximamente</span>
            </div>
            @foreach (var ev in proximos)
            {
                @await Html.PartialAsync("_EventoPublicoItem", ev)
            }
        }
    }
    <div style="padding:var(--sp-4) var(--sp-5);background:var(--color-surface-alt);border-top:1px solid var(--color-border-light);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--sp-3);">
        <span style="font-size:.8rem;color:var(--color-text-muted);">@(eventos.Count) evento(s) de tus mentores</span>
        <a asp-controller="Eventos" asp-action="Index" class="btn btn-ghost btn-sm">Ver todos →</a>
    </div>
</div>
