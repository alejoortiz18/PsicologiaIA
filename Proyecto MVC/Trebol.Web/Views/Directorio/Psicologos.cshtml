@model IEnumerable<Trebol.Model.DTOs.Directorio.ProfesionalDirectorioDto>
@using Trebol.Model.DTOs.Directorio
@{
    ViewData["Title"] = "Psicólogos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var items = Model.ToList();
    var filtro = ViewBag.Filtro as FiltroDirectorioDto ?? new FiltroDirectorioDto();
    var esPro = User.IsInRole("Profesional");

    ViewData["DirectorioTitulo"] = "Psicólogos";
    ViewData["DirectorioSubtitulo"] = "Psicólogos y terapeutas certificados ante COLPSIC.";
    ViewData["DirectorioPaginaActual"] = "Psicólogos";
    ViewData["Stat1Icon"] = "🧠";
    ViewData["Stat1Label"] = "Psicólogos";
    ViewData["Stat1Value"] = items.Count.ToString();
    ViewData["Stat2Icon"] = "⭐";
    ViewData["Stat2Label"] = "Con calificación";
    ViewData["Stat2Value"] = items.Count(p => p.Calificacion.HasValue).ToString();
    ViewData["Stat3Icon"] = esPro ? "📍" : "❤️";
    ViewData["Stat3Label"] = esPro ? "Con ciudad" : "Que sigues";
    ViewData["Stat3Value"] = esPro
        ? items.Count(p => !string.IsNullOrEmpty(p.Ciudad)).ToString()
        : items.Count(p => p.EsSeguido).ToString();
    ViewData["FiltroPlaceholder"] = "Buscar por nombre, especialidad o ocupación…";
    ViewBag.Ciudades = items.Where(p => !string.IsNullOrWhiteSpace(p.Ciudad))
        .Select(p => p.Ciudad!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);
}

@await Html.PartialAsync("_EncabezadoDirectorio")
@await Html.PartialAsync("_StatsDirectorio")
@await Html.PartialAsync("_FiltrosDirectorio", filtro)

<div class="directorio-results-info" id="results-info">
    @(items.Count) psicólogo@(items.Count == 1 ? "" : "s") en esta página
</div>

@await Html.PartialAsync("_ListaProfesionales", Model)

@section Scripts {
@Html.AntiForgeryToken()
@await Html.PartialAsync("_DirectorioScripts")
<script>
(function () {
  const search = document.getElementById('filter-search');
  const list = document.getElementById('prof-list');
  const info = document.getElementById('results-info');
  if (!search || !list) return;
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    list.querySelectorAll('.prof-card').forEach(card => {
      const n = card.getAttribute('data-nombre') || '';
      const show = !q || n.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (info) info.textContent = visible + ' resultado' + (visible === 1 ? '' : 's');
  });
})();
</script>
}
