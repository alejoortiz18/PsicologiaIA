@model IEnumerable<Trebol.Model.DTOs.Directorio.ProfesionalDirectorioDto>
@{
    var esProfesional = User.IsInRole("Profesional");
    string Iniciales(string nombre)
    {
        var partes = (nombre ?? "??").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => p.Length > 0 ? char.ToUpper(p[0]) : '?'));
    }
}

@if (!Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🔍</div>
        <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">No se encontraron profesionales</div>
        <div style="color:var(--color-text-muted);font-size:.875rem;">Intenta con otros filtros de búsqueda.</div>
    </div>
}
else
{
    <div class="prof-cards-list" id="prof-list" aria-live="polite" aria-label="Lista de profesionales">
        @foreach (var p in Model)
        {
            var ini = Iniciales(p.NombreCompleto);
            var nombreBusqueda = (p.NombreCompleto ?? "").ToLowerInvariant();
            var espTexto = string.Join(" ", p.Especialidades).ToLowerInvariant();
            <article class="prof-card" data-nombre="@nombreBusqueda @espTexto @(p.Titulo?.ToLowerInvariant() ?? "")">
                @if (!string.IsNullOrEmpty(p.FotoUrl))
                {
                    <img src="@p.FotoUrl" class="prof-card__avatar" style="object-fit:cover;" alt="" />
                }
                else
                {
                    <div class="prof-card__avatar">@ini</div>
                }
                <div class="prof-card__body">
                    <div class="prof-card__header">
                        <div>
                            <div class="prof-card__name">@p.NombreCompleto</div>
                            @if (!string.IsNullOrEmpty(p.Titulo))
                            {
                                <div class="prof-card__specialty">@p.Titulo</div>
                            }
                        </div>
                        @if (p.Calificacion.HasValue)
                        {
                            <span style="font-size:.8125rem;color:#f59e0b;white-space:nowrap;">⭐ @p.Calificacion.Value.ToString("F1")</span>
                        }
                    </div>
                    <div class="prof-card__meta">
                        @if (!string.IsNullOrEmpty(p.Ciudad))
                        {
                            <span>📍 @p.Ciudad</span>
                        }
                        @if (p.TotalSeguidos > 0)
                        {
                            <span>👥 @p.TotalSeguidos seguidores</span>
                        }
                    </div>
                    @if (p.Especialidades.Any())
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:var(--sp-2);margin-bottom:var(--sp-3);">
                            @foreach (var esp in p.Especialidades.Take(4))
                            {
                                <span class="badge badge-muted" style="font-size:.75rem;">@esp</span>
                            }
                        </div>
                    }
                    <div class="prof-card__actions">
                        @if (!esProfesional)
                        {
                            <a asp-controller="Citas" asp-action="NuevaCita" asp-route-profesionalId="@p.ProfesionalId"
                               class="btn btn-primary btn-sm">Agendar</a>
                            <button type="button" class="btn btn-secondary btn-sm btn-seguir"
                                    data-id="@p.ProfesionalId">
                                @(p.EsSeguido ? "Dejar de seguir" : "Seguir")
                            </button>
                        }
                        else
                        {
                            <a asp-controller="PerfilOrador" asp-action="Index" asp-route-id="@p.ProfesionalId"
                               class="btn btn-primary btn-sm">Ver perfil</a>
                            <button type="button" class="btn btn-secondary btn-sm btn-colega"
                                    data-id="@p.ProfesionalId">
                                Agregar colega
                            </button>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
