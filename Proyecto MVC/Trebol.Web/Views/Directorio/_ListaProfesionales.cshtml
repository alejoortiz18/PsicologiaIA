@model IEnumerable<Trebol.Model.DTOs.Directorio.ProfesionalDirectorioDto>

@if (!Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🔍</div>
        <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">No se encontraron profesionales</div>
        <div style="color:var(--color-text-muted);font-size:.875rem;">Intenta con otros filtros de búsqueda.</div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--sp-5);">
        @foreach (var p in Model)
        {
            var ini = string.Concat((p.NombreCompleto ?? "??").Split(' ').Take(2).Select(x => x.Length > 0 ? x[0].ToString() : ""));
            <div class="card" style="overflow:hidden;">
                <div style="padding:var(--sp-5);display:flex;gap:var(--sp-4);align-items:flex-start;">
                    @if (!string.IsNullOrEmpty(p.FotoUrl))
                    {
                        <img src="@p.FotoUrl" class="avatar" style="width:64px;height:64px;font-size:1.5rem;flex-shrink:0;" alt="foto" />
                    }
                    else
                    {
                        <div class="avatar" style="width:64px;height:64px;font-size:1.5rem;flex-shrink:0;">@ini</div>
                    }
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:700;color:var(--color-text-primary);margin-bottom:2px;">@p.NombreCompleto</div>
                        @if (!string.IsNullOrEmpty(p.Titulo))
                        {
                            <div style="font-size:.8rem;color:var(--color-text-muted);margin-bottom:var(--sp-2);">@p.Titulo</div>
                        }
                        <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:var(--sp-2);">
                            @foreach (var esp in p.Especialidades)
                            {
                                <span class="badge badge-muted" style="font-size:.68rem;">@esp</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(p.Ciudad))
                        {
                            <div style="font-size:.75rem;color:var(--color-text-muted);">📍 @p.Ciudad</div>
                        }
                        @if (p.Calificacion.HasValue)
                        {
                            <div style="font-size:.75rem;color:#f59e0b;">⭐ @p.Calificacion.Value.ToString("F1")</div>
                        }
                    </div>
                </div>
                <div style="padding:var(--sp-3) var(--sp-5);border-top:1px solid var(--color-border-light);display:flex;gap:var(--sp-2);">
                    <a asp-controller="Citas" asp-action="NuevaCita" asp-route-profesionalId="@p.ProfesionalId"
                       class="btn btn-primary btn-sm">Agendar</a>
                    <button class="btn btn-secondary btn-sm"
                            onclick="toggleSeguir(@p.ProfesionalId, this)">
                        @(p.EsSeguido ? "Dejar de seguir" : "Seguir")
                    </button>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
function toggleSeguir(profesionalId, btn) {
    fetch('/Directorio/ToggleSeguir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' },
        body: `profesionalId=${profesionalId}`
    })
    .then(r => r.json())
    .then(d => {
        if (d.exito) {
            const siguiendo = btn.textContent.trim() === 'Seguir';
            btn.textContent = siguiendo ? 'Dejar de seguir' : 'Seguir';
        }
    });
}
</script>
@Html.AntiForgeryToken()
}
