<script>
(function () {
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

  document.querySelectorAll('.btn-seguir').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const res = await fetch('/Directorio/ToggleSeguir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: `profesionalId=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
      });
      const d = await res.json();
      if (d.exito && typeof showToast === 'function') {
        showToast({ title: d.mensaje, type: 'success' });
        const estabaSiguiendo = btn.getAttribute('aria-pressed') === 'true';
        const ahoraSiguiendo = !estabaSiguiendo;
        btn.textContent = ahoraSiguiendo ? 'Siguiendo' : '+ Seguir';
        btn.classList.toggle('btn-mentor-active', ahoraSiguiendo);
        btn.classList.toggle('btn-primary', !ahoraSiguiendo);
        btn.setAttribute('aria-pressed', ahoraSiguiendo ? 'true' : 'false');

        const counterEl = document.getElementById('seguidores-count');
        if (counterEl) {
          const count = parseInt(counterEl.textContent.replace(/\D/g, ''), 10) || 0;
          const next = Math.max(0, count + (ahoraSiguiendo ? 1 : -1));
          counterEl.textContent = next.toLocaleString('es').replace(/,/g, ' ');
        }
      }
    });
  });

  document.querySelectorAll('.btn-colega').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const esDesvincular = btn.classList.contains('btn-desvincular');
      const res = await fetch('/Directorio/ToggleColega', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: `colegaId=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
      });
      const d = await res.json();
      if (typeof showToast === 'function') {
        showToast({ title: d.exito ? d.mensaje : (d.mensaje || 'Error'), type: d.exito ? 'success' : 'error' });
      }
      if (d.exito && esDesvincular) {
        btn.closest('.prof-card')?.remove();
        const list = document.getElementById('prof-list');
        const info = document.getElementById('results-info-colegas');
        if (list && info) {
          const total = list.querySelectorAll('.prof-card').length;
          info.textContent = total > 0
            ? 'Mostrando ' + total + ' de ' + total + ' registros en esta página'
            : '';
          if (total === 0) {
            location.reload();
          }
        }
      } else if (d.exito && !esDesvincular) {
        btn.textContent = 'Solicitud enviada';
        btn.disabled = true;
      }
    });
  });
})();
</script>
