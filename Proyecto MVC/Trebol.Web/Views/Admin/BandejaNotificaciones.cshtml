@model IReadOnlyList<Trebol.Model.DTOs.Admin.NotificacionDto>
@{
    ViewData["Title"] = "Bandeja de notificaciones";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var pendientes = Model?.Where(n => !n.Leida).ToList();
    var leidas = Model?.Where(n => n.Leida).ToList();
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-6);">
    <div>
        <h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin-bottom:4px;">🔔 Bandeja de notificaciones</h1>
        <p style="color:var(--color-text-muted);font-size:.875rem;margin:0;">Gestiona las solicitudes y alertas del sistema.</p>
    </div>
    <form asp-controller="Admin" asp-action="MarcarTodasLeidas" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-secondary btn-sm">Marcar todas leídas</button>
    </form>
</div>

@if (Model is null || !Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🔕</div>
        <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">No hay notificaciones</div>
        <div style="color:var(--color-text-muted);font-size:.875rem;">Todo al día por ahora.</div>
    </div>
}
else
{
    @if (pendientes != null && pendientes.Any())
    {
        <div style="margin-bottom:var(--sp-8);">
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-muted);margin-bottom:var(--sp-3);">
                Pendientes (@pendientes.Count)
            </div>
            <div class="card" style="overflow:hidden;">
                @foreach (var n in pendientes)
                {
                    <div style="padding:var(--sp-5);border-bottom:1px solid var(--color-border-light);background:rgba(82,183,136,.05);" id="notif-@n.NotificacionId">
                        <div style="display:flex;align-items:flex-start;gap:var(--sp-4);">
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--color-primary-pale);display:flex;align-items:center;justify-content:center;font-size:1.125rem;flex-shrink:0;">
                                @(n.Tipo == "RegistroProfesional" ? "🎓" : "🔔")
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:4px;">
                                    <span style="font-weight:700;font-size:.9rem;color:var(--color-text-primary);">@n.Titulo</span>
                                    <span class="badge badge-primary" style="font-size:.65rem;">Nueva</span>
                                    @if (n.EstadoProfesional == "PENDIENTE_VALIDACION")
                                    {
                                        <span style="display:inline-block;background:#FEF3C7;color:#92400E;border:1px solid #FCD34D;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">⏳ Sin validar por correo</span>
                                    }
                                    else if (n.EstadoProfesional == "PENDIENTE_APROBACION")
                                    {
                                        <span style="display:inline-block;background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">✅ Listo para revisión</span>
                                    }
                                    else if (n.EstadoProfesional == "RECHAZADO")
                                    {
                                        <span style="display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">❌ Rechazado</span>
                                    }
                                </div>
                                <p style="font-size:.8375rem;color:var(--color-text-secondary);margin:0 0 var(--sp-3);">@n.Mensaje</p>
                                @if (!string.IsNullOrWhiteSpace(n.MotivoRechazo))
                                {
                                    <div style="background:#FFF5F5;border-left:3px solid #ef4444;padding:8px 12px;border-radius:0 6px 6px 0;margin-bottom:var(--sp-3);font-size:.8rem;color:#7f1d1d;">
                                        <strong>Motivo de rechazo:</strong> @n.MotivoRechazo
                                    </div>
                                }
                                <div style="display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;">
                                    @if (n.Tipo == "RegistroProfesional" && n.ProfesionalId > 0)
                                    {
                                        var sinValidar = n.EstadoProfesional == "PENDIENTE_VALIDACION";
                                        <button class="btn btn-primary btn-sm btn-aprobar" data-id="@n.ProfesionalId" data-notif="@n.NotificacionId"
                                                @(sinValidar ? "disabled title=\"El profesional aún no confirmó su correo\"" : "")>
                                            ✅ Aprobar
                                        </button>
                                        <button class="btn btn-secondary btn-sm btn-rechazar" data-id="@n.ProfesionalId" data-notif="@n.NotificacionId"
                                                @(sinValidar ? "disabled title=\"El profesional aún no confirmó su correo\"" : "")>
                                            ❌ Rechazar
                                        </button>
                                    }
                                    <form asp-controller="Admin" asp-action="MarcarLeida" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="notificacionId" value="@n.NotificacionId" />
                                        <button type="submit" class="btn btn-ghost btn-sm" style="font-size:.75rem;">Marcar leída</button>
                                    </form>
                                </div>
                            </div>
                            <span style="font-size:.72rem;color:var(--color-text-muted);white-space:nowrap;flex-shrink:0;">@n.FechaCreacion.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (leidas != null && leidas.Any())
    {
        <div>
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-muted);margin-bottom:var(--sp-3);">
                Leídas (@leidas.Count)
            </div>
            <div class="card" style="overflow:hidden;opacity:.75;">
                @foreach (var n in leidas)
                {
                    <div style="padding:var(--sp-4) var(--sp-5);border-bottom:1px solid var(--color-border-light);">
                        <div style="display:flex;align-items:flex-start;gap:var(--sp-4);">
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;font-size:1.125rem;flex-shrink:0;">
                                @(n.Tipo == "RegistroProfesional" ? "🎓" : "🔔")
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;font-size:.875rem;color:var(--color-text-secondary);margin-bottom:4px;">@n.Titulo</div>
                                <p style="font-size:.8125rem;color:var(--color-text-muted);margin:0;">@n.Mensaje</p>
                            </div>
                            <span style="font-size:.72rem;color:var(--color-text-muted);white-space:nowrap;flex-shrink:0;">@n.FechaCreacion.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<!-- Modal: rechazar profesional (reglas UI/UX §4 — sin prompt nativo) -->
<div id="modal-rechazar-backdrop" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-rechazar-title">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-icon warning" aria-hidden="true">⚠️</div>
            <div>
                <div class="modal-title" id="modal-rechazar-title">Rechazar solicitud de profesional</div>
                <div class="modal-subtitle">El profesional recibirá un correo con el motivo indicado.</div>
            </div>
            <button type="button" class="modal-close" id="modal-rechazar-close" aria-label="Cerrar modal">✕</button>
        </div>
        <div class="modal-body">
            <p style="margin:0 0 var(--sp-4);">
                Esta acción notificará al solicitante por correo. El mensaje debe ser claro y en español de Colombia.
            </p>
            <div class="form-group" style="margin:0;">
                <label for="motivo-rechazo" class="form-label">
                    Motivo del rechazo <span class="required" aria-hidden="true">*</span>
                </label>
                <textarea id="motivo-rechazo" class="form-control" rows="4" maxlength="500"
                          placeholder="Ej: La tarjeta profesional está vencida. Sube un PDF vigente y legible."
                          aria-required="true"></textarea>
                <div class="form-hint">Mínimo 10 caracteres. Máximo 500.</div>
                <div id="motivo-rechazo-error" class="form-error" style="display:none;" role="alert"></div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="modal-rechazar-cancel">Cancelar</button>
            <button type="button" class="btn btn-danger" id="modal-rechazar-confirm" disabled>Enviar rechazo</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let rechazoProfesionalId = null;
let rechazoNotifId = null;
let rechazoBtnRef = null;
let rechazoDelayListo = false;

const modalRechazoBackdrop = document.getElementById('modal-rechazar-backdrop');
const motivoInput = document.getElementById('motivo-rechazo');
const motivoError = document.getElementById('motivo-rechazo-error');
const btnRechazoConfirm = document.getElementById('modal-rechazar-confirm');

function validarMotivoRechazo() {
    const texto = (motivoInput?.value || '').trim();
    const ok = texto.length >= 10;
    if (motivoError) {
        motivoError.style.display = ok ? 'none' : 'block';
        motivoError.textContent = ok ? '' : 'Escribe al menos 10 caracteres explicando el motivo.';
    }
    if (btnRechazoConfirm) btnRechazoConfirm.disabled = !ok || !rechazoDelayListo;
    return ok && rechazoDelayListo;
}

function abrirModalRechazo(profesionalId, notifId, btn) {
    rechazoProfesionalId = profesionalId;
    rechazoNotifId = notifId;
    rechazoBtnRef = btn;
    rechazoDelayListo = false;
    motivoInput.value = '';
    if (btnRechazoConfirm) {
        btnRechazoConfirm.disabled = true;
        btnRechazoConfirm.textContent = 'Enviar rechazo';
    }
    validarMotivoRechazo();
    if (typeof openModal === 'function') {
        openModal('modal-rechazar');
    }
    if (modalRechazoBackdrop && !modalRechazoBackdrop.classList.contains('open')) {
        modalRechazoBackdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    setTimeout(() => {
        rechazoDelayListo = true;
        motivoInput?.focus();
        validarMotivoRechazo();
    }, 800);
}

function cerrarModalRechazo() {
    if (typeof closeModal === 'function') closeModal('modal-rechazar');
    else modalRechazoBackdrop?.classList.remove('open');
    rechazoProfesionalId = null;
    rechazoNotifId = null;
    rechazoBtnRef = null;
}

motivoInput?.addEventListener('input', validarMotivoRechazo);

document.getElementById('modal-rechazar-close')?.addEventListener('click', cerrarModalRechazo);
document.getElementById('modal-rechazar-cancel')?.addEventListener('click', cerrarModalRechazo);

modalRechazoBackdrop?.addEventListener('click', (e) => {
    if (e.target === modalRechazoBackdrop) { /* formulario con datos: no cerrar por backdrop */ }
});

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalRechazoBackdrop?.classList.contains('open') && !btnRechazoConfirm?.disabled) {
        cerrarModalRechazo();
    }
});

btnRechazoConfirm?.addEventListener('click', async function enviarRechazo() {
    if (!validarMotivoRechazo() || !rechazoProfesionalId) return;

    const motivo = motivoInput.value.trim();
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const btn = rechazoBtnRef;

    btnRechazoConfirm.disabled = true;
    btnRechazoConfirm.textContent = 'Enviando…';
    if (btn) { btn.disabled = true; }

    try {
        const res = await fetch('/Admin/RechazarProfesional', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `profesionalId=${rechazoProfesionalId}&motivo=${encodeURIComponent(motivo)}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
        const data = await res.json();
        if (data.exito) {
            cerrarModalRechazo();
            const row = document.getElementById('notif-' + rechazoNotifId);
            if (row) row.style.opacity = '.5';
            if (btn) btn.textContent = '❌ Rechazado';
            if (typeof showToast === 'function') {
                showToast({
                    title: 'Solicitud rechazada',
                    message: 'Se envió el correo al profesional con el motivo indicado.',
                    type: 'success'
                });
            }
        } else {
            if (typeof showToast === 'function') {
                showToast({ title: 'No se pudo rechazar', message: data.mensaje || 'Error desconocido', type: 'error' });
            }
            btnRechazoConfirm.disabled = false;
            btnRechazoConfirm.textContent = 'Enviar rechazo';
            if (btn) { btn.disabled = false; }
        }
    } catch (err) {
        if (typeof showToast === 'function') {
            showToast({ title: 'Error de conexión', message: 'Intenta de nuevo en unos segundos.', type: 'error' });
        }
        btnRechazoConfirm.disabled = false;
        btnRechazoConfirm.textContent = 'Enviar rechazo';
        if (btn) btn.disabled = false;
    }
});

document.querySelectorAll('.btn-aprobar').forEach(btn => {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        this.disabled = true;
        this.textContent = 'Procesando…';
        const res = await fetch('/Admin/AprobarProfesional', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `profesionalId=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
        const data = await res.json();
        if (data.exito) {
            const row = document.getElementById('notif-' + this.dataset.notif);
            if (row) { row.style.opacity = '.5'; }
            this.textContent = '✅ Aprobado';
            if (typeof showToast === 'function') {
                showToast({ title: 'Profesional aprobado', message: data.mensaje || '', type: 'success' });
            }
        } else {
            if (typeof showToast === 'function') {
                showToast({ title: 'Error', message: data.mensaje || '', type: 'error' });
            }
            this.disabled = false;
            this.textContent = '✅ Aprobar';
        }
    });
});

document.querySelectorAll('.btn-rechazar').forEach(btn => {
    btn.addEventListener('click', function() {
        if (this.disabled) return;
        abrirModalRechazo(this.dataset.id, this.dataset.notif, this);
    });
});
</script>
}
