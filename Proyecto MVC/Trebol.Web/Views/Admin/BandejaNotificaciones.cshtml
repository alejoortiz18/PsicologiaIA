@model IReadOnlyList<Trebol.Model.DTOs.Admin.NotificacionDto>
@{
    ViewData["Title"] = "Bandeja de notificaciones";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var pendientes = Model?.Where(n => !n.Leida).ToList();
    var leidas = Model?.Where(n => n.Leida).ToList();
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-6);">
    <div>
        <h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin-bottom:4px;">🔔 Bandeja de notificaciones</h1>
        <p style="color:var(--color-text-muted);font-size:.875rem;margin:0;">Gestiona las solicitudes y alertas del sistema.</p>
    </div>
    <form asp-controller="Admin" asp-action="MarcarTodasLeidas" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-secondary btn-sm">Marcar todas leídas</button>
    </form>
</div>

@if (Model is null || !Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🔕</div>
        <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">No hay notificaciones</div>
        <div style="color:var(--color-text-muted);font-size:.875rem;">Todo al día por ahora.</div>
    </div>
}
else
{
    @if (pendientes != null && pendientes.Any())
    {
        <div style="margin-bottom:var(--sp-8);">
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-muted);margin-bottom:var(--sp-3);">
                Pendientes (@pendientes.Count)
            </div>
            <div class="card" style="overflow:hidden;">
                @foreach (var n in pendientes)
                {
                    <div style="padding:var(--sp-5);border-bottom:1px solid var(--color-border-light);background:rgba(82,183,136,.05);" id="notif-@n.NotificacionId">
                        <div style="display:flex;align-items:flex-start;gap:var(--sp-4);">
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--color-primary-pale);display:flex;align-items:center;justify-content:center;font-size:1.125rem;flex-shrink:0;">
                                @(n.Tipo == "RegistroProfesional" ? "🎓" : "🔔")
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:4px;">
                                    <span style="font-weight:700;font-size:.9rem;color:var(--color-text-primary);">@n.Titulo</span>
                                    <span class="badge badge-primary" style="font-size:.65rem;">Nueva</span>
                                    @if (n.EstadoProfesional == "PENDIENTE_VALIDACION")
                                    {
                                        <span style="display:inline-block;background:#FEF3C7;color:#92400E;border:1px solid #FCD34D;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">⏳ Sin validar por correo</span>
                                    }
                                    else if (n.EstadoProfesional == "PENDIENTE_APROBACION")
                                    {
                                        <span style="display:inline-block;background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">✅ Listo para revisión</span>
                                    }
                                    else if (n.EstadoProfesional == "RECHAZADO")
                                    {
                                        <span style="display:inline-block;background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;border-radius:20px;font-size:.65rem;font-weight:700;padding:2px 8px;">❌ Rechazado</span>
                                    }
                                </div>
                                <p style="font-size:.8375rem;color:var(--color-text-secondary);margin:0 0 var(--sp-3);">@n.Mensaje</p>
                                @if (!string.IsNullOrWhiteSpace(n.MotivoRechazo))
                                {
                                    <div style="background:#FFF5F5;border-left:3px solid #ef4444;padding:8px 12px;border-radius:0 6px 6px 0;margin-bottom:var(--sp-3);font-size:.8rem;color:#7f1d1d;">
                                        <strong>Motivo de rechazo:</strong> @n.MotivoRechazo
                                    </div>
                                }
                                <div style="display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap;">
                                    @if (n.Tipo == "RegistroProfesional" && n.ProfesionalId > 0)
                                    {
                                        var sinValidar = n.EstadoProfesional == "PENDIENTE_VALIDACION";
                                        <button class="btn btn-primary btn-sm btn-aprobar" data-id="@n.ProfesionalId" data-notif="@n.NotificacionId"
                                                @(sinValidar ? "disabled title=\"El profesional aún no confirmó su correo\"" : "")>
                                            ✅ Aprobar
                                        </button>
                                        <button class="btn btn-secondary btn-sm btn-rechazar" data-id="@n.ProfesionalId" data-notif="@n.NotificacionId"
                                                @(sinValidar ? "disabled title=\"El profesional aún no confirmó su correo\"" : "")>
                                            ❌ Rechazar
                                        </button>
                                    }
                                    <form asp-controller="Admin" asp-action="MarcarLeida" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="notificacionId" value="@n.NotificacionId" />
                                        <button type="submit" class="btn btn-ghost btn-sm" style="font-size:.75rem;">Marcar leída</button>
                                    </form>
                                </div>
                            </div>
                            <span style="font-size:.72rem;color:var(--color-text-muted);white-space:nowrap;flex-shrink:0;">@n.FechaCreacion.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (leidas != null && leidas.Any())
    {
        <div>
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-muted);margin-bottom:var(--sp-3);">
                Leídas (@leidas.Count)
            </div>
            <div class="card" style="overflow:hidden;opacity:.75;">
                @foreach (var n in leidas)
                {
                    <div style="padding:var(--sp-4) var(--sp-5);border-bottom:1px solid var(--color-border-light);">
                        <div style="display:flex;align-items:flex-start;gap:var(--sp-4);">
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;font-size:1.125rem;flex-shrink:0;">
                                @(n.Tipo == "RegistroProfesional" ? "🎓" : "🔔")
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:600;font-size:.875rem;color:var(--color-text-secondary);margin-bottom:4px;">@n.Titulo</div>
                                <p style="font-size:.8125rem;color:var(--color-text-muted);margin:0;">@n.Mensaje</p>
                            </div>
                            <span style="font-size:.72rem;color:var(--color-text-muted);white-space:nowrap;flex-shrink:0;">@n.FechaCreacion.ToString("dd/MM HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
<script>
const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

document.querySelectorAll('.btn-aprobar').forEach(btn => {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        this.disabled = true;
        this.textContent = 'Procesando…';
        const res = await fetch('/Admin/AprobarProfesional', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `profesionalId=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
        const data = await res.json();
        if (data.exito) {
            const row = document.getElementById('notif-' + this.dataset.notif);
            if (row) { row.style.opacity = '.5'; }
            this.textContent = '✅ Aprobado';
        } else {
            alert('Error: ' + data.mensaje);
            this.disabled = false;
            this.textContent = '✅ Aprobar';
        }
    });
});

document.querySelectorAll('.btn-rechazar').forEach(btn => {
    btn.addEventListener('click', async function() {
        const id = this.dataset.id;
        const motivo = prompt('Motivo del rechazo:');
        if (!motivo) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        this.disabled = true;
        const res = await fetch('/Admin/RechazarProfesional', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `profesionalId=${id}&motivo=${encodeURIComponent(motivo)}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
        const data = await res.json();
        if (data.exito) {
            const row = document.getElementById('notif-' + this.dataset.notif);
            if (row) { row.style.opacity = '.5'; }
            this.textContent = '❌ Rechazado';
        } else {
            alert('Error: ' + data.mensaje);
            this.disabled = false;
            this.textContent = '❌ Rechazar';
        }
    });
});
</script>
}
