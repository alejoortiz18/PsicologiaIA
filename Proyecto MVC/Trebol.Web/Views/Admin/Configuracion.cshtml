@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewData["Title"] = "Configuración del sistema";
    var iva = ViewBag.PorcentajeIva as decimal? ?? 19m;
}

<header class="topbar" style="margin-bottom:var(--sp-6);">
    <span class="topbar__title">Configuración del sistema</span>
    <div class="topbar__spacer"></div>
</header>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-error mb-4" role="alert">@err</div>
}
@if (TempData["Mensaje"] is string ok)
{
    <div class="alert alert-success mb-4" role="alert">@ok</div>
}

<div class="checkout-card" style="max-width:520px;">
    <h2 class="checkout-card__title">IVA en citas privadas</h2>
    <p class="text-meta mb-4">
        Porcentaje aplicado sobre el valor de la cita privada al calcular el total a pagar.
    </p>

    <form asp-controller="Admin" asp-action="GuardarIva" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group mb-4">
            <label for="porcentajeIva" class="form-label">Porcentaje de IVA (%)</label>
            <input type="number" id="porcentajeIva" name="porcentajeIva"
                   class="form-control" min="0" max="100" step="0.01"
                   value="@iva.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
            <small class="text-meta">Ejemplo: 19 → subtotal + 19% de IVA.</small>
        </div>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
</div>
