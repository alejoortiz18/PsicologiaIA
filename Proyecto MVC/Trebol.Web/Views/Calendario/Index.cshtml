@model IEnumerable<Trebol.Model.Entities.TrebolEntities.HorarioDisponible>
@{
    ViewData["Title"] = "Mi Calendario";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var bloqueos = ViewBag.Bloqueos as IEnumerable<Trebol.Model.Entities.TrebolEntities.HorarioBloqueado> ?? [];
    var diasSemana = new[] { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };
}

<h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin-bottom:var(--sp-6);">🗃 Mi calendario de disponibilidad</h1>

<div style="display:grid;grid-template-columns:1fr 360px;gap:var(--sp-6);">

    <!-- Horarios disponibles -->
    <div>
        <div class="card" style="overflow:hidden;">
            <div style="padding:var(--sp-4) var(--sp-5);background:var(--color-surface-alt);border-bottom:1px solid var(--color-border-light);font-weight:700;font-size:.875rem;">Horarios disponibles</div>
            @if (!Model.Any())
            {
                <div style="padding:var(--sp-8);text-align:center;color:var(--color-text-muted);">No tienes horarios configurados.</div>
            }
            else
            {
                <table style="width:100%;border-collapse:collapse;font-size:.855rem;">
                    <thead style="background:var(--color-surface-alt);">
                        <tr>
                            <th style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-muted);">Día</th>
                            <th style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-muted);">Inicio</th>
                            <th style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--color-text-muted);">Fin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.OrderBy(x => x.DiaSemana))
                        {
                            <tr style="border-bottom:1px solid var(--color-border-light);">
                                <td style="padding:var(--sp-3) var(--sp-4);font-weight:600;">@diasSemana[h.DiaSemana]</td>
                                <td style="padding:var(--sp-3) var(--sp-4);color:var(--color-text-secondary);">@h.HoraInicio.ToString("HH:mm")</td>
                                <td style="padding:var(--sp-3) var(--sp-4);color:var(--color-text-secondary);">@h.HoraFin.ToString("HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Panel derecho: bloquear + bloqueos activos -->
    <div>
        <div class="card" style="margin-bottom:var(--sp-5);">
            <div style="padding:var(--sp-4) var(--sp-5);background:var(--color-surface-alt);border-bottom:1px solid var(--color-border-light);font-weight:700;font-size:.875rem);">Bloquear horario</div>
            <div style="padding:var(--sp-5);">
                <div class="form-group">
                    <label class="form-label">Desde</label>
                    <input type="datetime-local" id="blqInicio" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Hasta</label>
                    <input type="datetime-local" id="blqFin" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Motivo (opcional)</label>
                    <input type="text" id="blqMotivo" class="form-control" />
                </div>
                <button class="btn btn-secondary w-full" onclick="bloquear()">Bloquear horario</button>
            </div>
        </div>

        @if (bloqueos.Any())
        {
            <div class="card" style="overflow:hidden;">
                <div style="padding:var(--sp-4) var(--sp-5);background:var(--color-surface-alt);border-bottom:1px solid var(--color-border-light);font-weight:700;font-size:.875rem;">Bloqueos activos</div>
                @foreach (var b in bloqueos)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:var(--sp-3) var(--sp-4);border-bottom:1px solid var(--color-border-light);">
                        <div>
                            <div style="font-size:.8rem;font-weight:600;">@b.FechaHoraInicio.ToString("dd/MM HH:mm") — @b.FechaHoraFin.ToString("dd/MM HH:mm")</div>
                            @if (!string.IsNullOrEmpty(b.Motivo)) { <div style="font-size:.75rem;color:var(--color-text-muted);">@b.Motivo</div> }
                        </div>
                        <button class="btn btn-ghost btn-sm" onclick="desbloquear(@b.BloqueoId)" style="color:var(--color-danger);">✕</button>
                    </div>
                }
            </div>
        }
    </div>

</div>

@section Scripts {
<script>
function bloquear() {
    const inicio  = document.getElementById('blqInicio').value;
    const fin     = document.getElementById('blqFin').value;
    const motivo  = document.getElementById('blqMotivo').value;
    if (!inicio || !fin) { alert('Selecciona fecha de inicio y fin.'); return; }
    fetch('/Calendario/Bloquear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' },
        body: `inicio=${encodeURIComponent(inicio)}&fin=${encodeURIComponent(fin)}&motivo=${encodeURIComponent(motivo)}`
    })
    .then(r => r.json())
    .then(d => { alert(d.mensaje); if (d.exito) location.reload(); });
}
function desbloquear(bloqueoId) {
    if (!confirm('¿Desbloquear este horario?')) return;
    fetch('/Calendario/Desbloquear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' },
        body: `bloqueoId=${bloqueoId}`
    })
    .then(r => r.json())
    .then(d => { alert(d.mensaje); if (d.exito) location.reload(); });
}
</script>
@Html.AntiForgeryToken()
}
