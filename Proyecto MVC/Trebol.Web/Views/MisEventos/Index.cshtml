@model IEnumerable<Trebol.Model.DTOs.Sala.SalaDto>
@{
    ViewData["Title"] = "Mis Eventos";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin-bottom:var(--sp-6);">🎪 Mis eventos</h1>

@if (!Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🎪</div>
        <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:8px;">No estás inscrito en ningún evento</div>
        <div style="color:var(--color-text-muted);font-size:.875rem;">Explora las salas disponibles y únete a conferencias.</div>
        <div style="margin-top:var(--sp-6);">
            <a asp-controller="Directorio" asp-action="Medicos" class="btn btn-primary">Explorar profesionales</a>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:var(--sp-5);">
        @foreach (var sala in Model)
        {
            <div class="card" style="overflow:hidden;">
                @if (!string.IsNullOrEmpty(sala.ImagenUrl))
                {
                    <img src="@sala.ImagenUrl" style="width:100%;height:140px;object-fit:cover;" alt="evento" />
                }
                else
                {
                    <div style="height:100px;background:linear-gradient(135deg,var(--color-primary),var(--color-primary-light));display:flex;align-items:center;justify-content:center;font-size:2.5rem;">🎪</div>
                }
                <div style="padding:var(--sp-5);">
                    <div style="font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">@sala.Titulo</div>
                    <div style="font-size:.8rem;color:var(--color-text-muted);margin-bottom:var(--sp-3);">
                        @sala.Descripcion
                    </div>
                    @if (sala.FechaInicio.HasValue)
                    {
                        <div style="font-size:.8rem;font-weight:600;color:var(--color-primary);margin-bottom:var(--sp-3);">📅 @sala.FechaInicio.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:var(--sp-4);">
                        <span class="badge badge-primary">@sala.Tipo</span>
                        <span class="badge @(sala.Estado.ToString() == "Abierta" ? "badge-success" : "badge-muted")">@sala.Estado</span>
                        @if (!string.IsNullOrEmpty(sala.Categoria))
                        {
                            <span class="badge badge-muted">@sala.Categoria</span>
                        }
                    </div>
                    <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;">
                        @if (User.IsInRole("Profesional") && sala.Estado.ToString() == "Abierta")
                        {
                            <a asp-controller="Salas" asp-action="SalaConferenciaProfesional" asp-route-id="@sala.SalaId" class="btn btn-primary btn-sm">▶ Gestionar</a>
                        }
                        <a asp-controller="Salas" asp-action="Detalle" asp-route-id="@sala.SalaId" class="btn btn-ghost btn-sm">Ver sala</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
