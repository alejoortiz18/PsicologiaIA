@model ReenviarConfirmacionViewModel
@{
    ViewData["Title"] = "Reenviar confirmación";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
    var mensaje = ViewData["Mensaje"] as string;
}

@section Styles {
<style>
body { background: var(--color-surface); }
.public-nav, footer { display: none; }
</style>
}

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:var(--sp-8) var(--sp-4);">
  <div class="card" style="max-width:520px;width:100%;padding:var(--sp-10);">

    <div style="text-align:center;margin-bottom:var(--sp-6);">
      <div style="font-size:3rem;margin-bottom:var(--sp-3);">📧</div>
      <h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin:0 0 var(--sp-2);">
        Reenviar confirmación
      </h1>
      <p style="color:var(--color-text-secondary);line-height:1.6;margin:0;font-size:.9rem;">
        Generaremos un <strong>nuevo enlace</strong> de confirmación (válido 1 hora) y lo enviaremos a tu correo.
      </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
      <div class="alert alert-info" style="margin-bottom:var(--sp-5);">@mensaje</div>
    }

    <form asp-action="ReenviarConfirmacion" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="form-error" style="margin-bottom:var(--sp-4);"></div>

      <div class="form-group">
        <label asp-for="Correo" class="form-label">Correo electrónico</label>
        <input asp-for="Correo" class="form-control" placeholder="usuario@correo.com" autocomplete="email" />
        <span asp-validation-for="Correo" class="form-error"></span>
      </div>

      <button type="submit" class="btn btn-primary w-full" style="margin-top:var(--sp-4);">
        Reenviar correo de confirmación
      </button>
    </form>

    <div style="text-align:center;margin-top:var(--sp-6);">
      <a asp-controller="Login" asp-action="Index" class="text-sm" style="color:var(--color-primary-light);">← Volver al inicio de sesión</a>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
