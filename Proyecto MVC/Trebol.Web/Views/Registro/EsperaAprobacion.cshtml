@{
    ViewData["Title"] = "Solicitud en revisión";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

@section Styles {
<style>
body { background: var(--color-surface); }
.public-nav, footer { display: none; }
</style>
}

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:var(--sp-8) var(--sp-4);">
  <div class="card" style="max-width:560px;width:100%;padding:var(--sp-10);text-align:center;">

    @if (TempData["Mensaje"] != null)
    {
      <div class="form-success" style="margin-bottom:var(--sp-6);">@TempData["Mensaje"]</div>
    }

    <div style="width:80px;height:80px;background:linear-gradient(135deg,#E8F5E9,#B7E4C7);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin:0 auto var(--sp-6);">
      ⏳
    </div>
    <h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.6rem;margin-bottom:var(--sp-3);">
      Solicitud en revisión
    </h1>
    <p style="color:var(--color-text-secondary);line-height:1.7;margin-bottom:var(--sp-6);">
      Tu cuenta está pendiente de aprobación por parte del equipo de Trébol. Recibirás un correo electrónico con el resultado en un plazo de <strong>3 a 5 días hábiles</strong>.
    </p>

    <div style="background:rgba(82,183,136,.08);border:1px solid rgba(82,183,136,.2);border-radius:var(--radius-lg);padding:var(--sp-6);margin-bottom:var(--sp-6);text-align:left;">
      <div style="font-weight:700;color:var(--color-primary);margin-bottom:var(--sp-3);">¿Qué sigue?</div>
      <div style="display:flex;align-items:flex-start;gap:var(--sp-3);margin-bottom:var(--sp-3);">
        <span style="width:24px;height:24px;background:#52B788;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.75rem;font-weight:700;flex-shrink:0;">1</span>
        <span style="color:var(--color-text-secondary);font-size:.9rem;">El equipo revisará tus documentos y tarjeta profesional.</span>
      </div>
      <div style="display:flex;align-items:flex-start;gap:var(--sp-3);margin-bottom:var(--sp-3);">
        <span style="width:24px;height:24px;background:#52B788;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.75rem;font-weight:700;flex-shrink:0;">2</span>
        <span style="color:var(--color-text-secondary);font-size:.9rem;">Recibirás un correo con la decisión de aprobación.</span>
      </div>
      <div style="display:flex;align-items:flex-start;gap:var(--sp-3);">
        <span style="width:24px;height:24px;background:#52B788;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.75rem;font-weight:700;flex-shrink:0;">3</span>
        <span style="color:var(--color-text-secondary);font-size:.9rem;">Si es aprobada, podrás iniciar sesión y usar la plataforma.</span>
      </div>
    </div>

    <a asp-controller="Login" asp-action="Index" class="btn btn-secondary" style="display:inline-block;">
      ← Ir al inicio de sesión
    </a>
  </div>
</div>
