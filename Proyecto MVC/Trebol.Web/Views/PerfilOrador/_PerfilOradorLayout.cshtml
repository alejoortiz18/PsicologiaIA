@model Trebol.Model.DTOs.PerfilOrador.PerfilOradorPublicoVm
@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewData["EsPerfilPublico"] = true;
    ViewData["Title"] = "Perfil del orador";
}

@section Styles {
    <link rel="stylesheet" href="~/css/perfil-orador.css" asp-append-version="true" />
    @await RenderSectionAsync("PerfilStyles", required: false)
}

<div class="perfil-orador-publico">
    @await Html.PartialAsync("_PerfilOradorEncabezado", Model)
    @await Html.PartialAsync("_PerfilOradorTabs", Model)
    @RenderBody()
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("~/Views/Directorio/_DirectorioScripts.cshtml")
    @await RenderSectionAsync("PerfilScripts", required: false)
}
