@model IEnumerable<Trebol.Model.DTOs.Sala.SalaDto>
@{
    ViewData["Title"] = "Mis Salas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--sp-6);">
    <h1 style="font-family:var(--font-display);color:var(--color-primary);font-size:1.5rem;margin:0;">🎤 Mis salas como orador</h1>
    <button type="button" class="btn btn-primary" data-open-nueva-sala>+ Nueva sala</button>
</div>

@if (!Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">🎬</div>
        <div style="font-weight:600;color:var(--color-text-primary);">No tienes salas creadas</div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--sp-5);">
        @foreach (var sala in Model)
        {
            <div class="card" style="overflow:hidden;">
                <div style="padding:var(--sp-5);">
                    <div style="font-weight:700;color:var(--color-text-primary);margin-bottom:6px;">@sala.Titulo</div>
                    <div style="font-size:.8rem;color:var(--color-text-muted);margin-bottom:var(--sp-3);">@sala.Descripcion</div>
                    <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:var(--sp-3);">
                        <span class="badge badge-primary">@sala.Tipo</span>
                        <span class="badge @(sala.Estado.ToString() == "Abierta" ? "badge-success" : "badge-muted")">@sala.Estado</span>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <span style="font-size:.8rem;color:var(--color-text-muted);">👥 @sala.TotalInscritos inscritos de @sala.Capacidad</span>
                        <a asp-controller="Salas" asp-action="Detalle" asp-route-id="@sala.SalaId" class="btn btn-ghost btn-sm">Ver</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
