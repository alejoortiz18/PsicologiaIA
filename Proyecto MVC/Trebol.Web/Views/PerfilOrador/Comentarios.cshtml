@model Trebol.Model.DTOs.PerfilOrador.PerfilOradorPublicoVm
@using Trebol.Model.DTOs.PerfilOrador
@{
    Layout = "~/Views/PerfilOrador/_PerfilOradorLayout.cshtml";
    var res = Model.ResumenComentarios;
    var cultura = new System.Globalization.CultureInfo("es-CO");
    string Estrellas(byte? n)
    {
        if (!n.HasValue) return "";
        return new string('★', n.Value) + new string('☆', 5 - n.Value);
    }
}

<div id="tab-comentarios">
    @if (TempData["Mensaje"] is string ok)
    {
        <div class="alert alert-success mb-4" role="status">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger mb-4" role="alert">@err</div>
    }

    @if (res.Total > 0)
    {
        <div class="perfil-orador-rating-summary">
            <div class="perfil-orador-rating-summary__score">
                <div class="perfil-orador-rating-summary__score-val">@res.Promedio.ToString("F1", cultura)</div>
                <div class="perfil-orador-rating-summary__stars">★★★★★</div>
                <div class="text-meta">de 5 · @res.Total opiniones</div>
            </div>
            <div class="perfil-orador-rating-bars">
                @for (byte s = 5; s >= 1; s--)
                {
                    var pct = res.Porcentaje(s);
                    <div class="perfil-orador-rating-bar-row">
                        <span>@(s)★</span>
                        <div class="perfil-orador-rating-bar-track">
                            <div class="perfil-orador-rating-bar-fill" style="width:@(pct)%;"></div>
                        </div>
                        <span>@pct%</span>
                    </div>
                }
            </div>
        </div>
    }

    <div class="perfil-orador-panel perfil-orador-comments-panel">
        @if (!Model.Comentarios.Any())
        {
            <p class="text-meta" style="margin:0;">Aún no hay comentarios. Sé el primero en compartir tu experiencia.</p>
        }
        else
        {
            <div class="comments-feed" role="list" aria-label="Comentarios sobre @Model.Perfil.NombreCompleto">
                @foreach (var c in Model.Comentarios)
                {
                    <div class="comment @(c.EsPropio ? "comment--own" : "comment--other")" role="listitem"@(c.EsPropio ? Html.Raw(" aria-label=\"Tu comentario\"") : null)>
                        @if (!c.EsPropio)
                        {
                            <div class="comment__avatar">@c.Iniciales</div>
                        }
                        <div class="comment__body">
                            <div class="comment__bubble @(c.EsPropio ? "comment__bubble--own" : "")">
                                @if (c.Puntuacion.HasValue)
                                {
                                    <div class="comment__stars">@Estrellas(c.Puntuacion)</div>
                                }
                                <p>@c.Contenido</p>
                            </div>
                            <div class="comment__meta" style="@(c.EsPropio ? "text-align:right;" : "")">
                                @c.Fecha.ToString("d MMM yyyy · h:mm tt", cultura)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.PuedeComentar)
        {
            <div class="perfil-orador-form-comentario">
                <form asp-action="PublicarComentario" asp-route-id="@Model.Perfil.ProfesionalId" method="post">
                    @Html.AntiForgeryToken()
                    <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);">
                        <label class="form-label" style="margin:0;">Tu calificación:</label>
                        <div id="star-rating" class="perfil-orador-star-rating" aria-label="Calificar" role="group">
                            @for (byte i = 1; i <= 5; i++)
                            {
                                <span class="star" data-val="@i" aria-label="@i estrellas" tabindex="0">★</span>
                            }
                        </div>
                        <input type="hidden" name="puntuacion" id="puntuacion-input" value="5" />
                    </div>
                    <label for="nuevo-comentario" class="form-label">Escribir un comentario</label>
                    <div style="display:flex;gap:var(--sp-3);align-items:flex-end;flex-wrap:wrap;">
                        <textarea id="nuevo-comentario" name="contenido" class="form-control" rows="3" required maxlength="2000"
                                  placeholder="Comparte tu experiencia…" aria-label="Escribe tu comentario" style="flex:1;min-width:220px;resize:vertical;"></textarea>
                        <button type="submit" class="btn btn-primary" aria-label="Enviar comentario">Enviar</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@section PerfilScripts {
    <script src="~/js/perfil-orador.js" asp-append-version="true"></script>
}
