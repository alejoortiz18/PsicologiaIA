@model IEnumerable<Trebol.Model.DTOs.Cita.CitaListaDto>
@using Trebol.Model.DTOs.Common
@using Trebol.Model.DTOs.Profesional
@using Trebol.Model.Enums
@{
    ViewData["Title"] = "Mi perfil · Citas";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var prof = ViewBag.Profesional as Trebol.Model.Entities.TrebolEntities.Profesional;
    var resumen = ViewBag.Resumen as PerfilProfesionalResumenDto ?? new PerfilProfesionalResumenDto();
    var pag = ViewBag.Paginacion as PaginacionVm ?? new PaginacionVm();
    var estado = ViewBag.EstadoFiltro as string ?? "Todos";
    var buscar = ViewBag.Buscar as string ?? "";
    var vista = ViewBag.Vista as string ?? "proximas";
    string BadgeCita(EstadoCita e) => e switch
    {
        EstadoCita.Programada => "badge-success",
        EstadoCita.Cancelada => "badge-danger",
        EstadoCita.Movida => "badge-warning",
        _ => "badge-muted"
    };
    string LabelCita(EstadoCita e) => e switch
    {
        EstadoCita.Finalizada => "Completada",
        EstadoCita.Programada => "Programada",
        EstadoCita.Movida => "Reprogramada",
        EstadoCita.Cancelada => "Cancelada",
        _ => e.ToString()
    };
}

@await Html.PartialAsync("_PerfilShell", prof)

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--sp-4);margin-bottom:var(--sp-6);">
    <div style="background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--sp-5);border:1px solid var(--color-border-light);text-align:center;">
        <div style="font-size:1.75rem;font-weight:700;color:var(--color-primary);">@resumen.CitasProximas</div>
        <div class="text-meta">Próximas</div>
    </div>
    <div style="background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--sp-5);border:1px solid var(--color-border-light);text-align:center;">
        <div style="font-size:1.75rem;font-weight:700;color:#E65100;">@resumen.CitasPendientes</div>
        <div class="text-meta">Programadas</div>
    </div>
    <div style="background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--sp-5);border:1px solid var(--color-border-light);text-align:center;">
        <div style="font-size:1.75rem;font-weight:700;color:#2D6A4F;">@resumen.CitasCompletadas</div>
        <div class="text-meta">Completadas</div>
    </div>
    <div style="background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--sp-5);border:1px solid var(--color-border-light);text-align:center;">
        <div style="font-size:1.75rem;font-weight:700;color:var(--color-danger);">@resumen.CitasCanceladas</div>
        <div class="text-meta">Canceladas</div>
    </div>
</div>

<form method="get" asp-action="Citas" style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4);flex-wrap:wrap;margin-bottom:var(--sp-5);">
    <input type="hidden" name="vista" value="@vista" />
    <div class="prof-filter-bar" style="flex:1;max-width:580px;display:flex;gap:var(--sp-3);">
        <input type="search" name="buscar" class="form-control" placeholder="Buscar paciente..." value="@buscar" />
        <select name="estado" class="form-control" style="max-width:180px;">
            <option value="Todos" selected="@(estado == "Todos")">Todos los estados</option>
            <option value="Programada" selected="@(estado == "Programada")">Programada</option>
            <option value="Movida" selected="@(estado == "Movida")">Reprogramada</option>
            <option value="Finalizada" selected="@(estado == "Finalizada")">Completada</option>
            <option value="Cancelada" selected="@(estado == "Cancelada")">Cancelada</option>
        </select>
        <button type="submit" class="btn btn-secondary btn-sm">Filtrar</button>
    </div>
</form>

<div class="tabs" style="margin-bottom:var(--sp-5);display:flex;gap:var(--sp-2);">
    <a asp-action="Citas" asp-route-vista="proximas" asp-route-estado="@estado" asp-route-buscar="@buscar"
       class="tab-item @(vista == "proximas" ? "active" : "")" style="text-decoration:none;">📆 Próximas</a>
    <a asp-action="Citas" asp-route-vista="historial" asp-route-estado="@estado" asp-route-buscar="@buscar"
       class="tab-item @(vista == "historial" ? "active" : "")" style="text-decoration:none;">🗂 Historial</a>
</div>

@if (!Model.Any())
{
    <div class="card" style="padding:var(--sp-12);text-align:center;">
        <div style="font-size:3rem;margin-bottom:var(--sp-4);">📅</div>
        <div style="font-weight:600;color:var(--color-text-primary);">No hay citas en este filtro</div>
    </div>
}
else
{
    <div style="background:var(--color-surface);border-radius:var(--radius-xl);box-shadow:var(--shadow-sm);border:1px solid var(--color-border-light);overflow:hidden;">
        <div style="overflow-x:auto;">
            <table style="width:100%;border-collapse:collapse;font-size:.855rem;" aria-label="Citas">
                <thead style="background:var(--color-surface-alt);">
                    <tr>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Paciente</th>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Tipo</th>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Fecha</th>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Duración</th>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Estado</th>
                        <th scope="col" style="padding:var(--sp-3) var(--sp-4);text-align:left;font-size:.72rem;text-transform:uppercase;color:var(--color-text-muted);">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cita in Model)
                    {
                        var aliasIni = (cita.AliasUsuario ?? "??").Length >= 2 ? cita.AliasUsuario![..2] : cita.AliasUsuario;
                        <tr style="border-bottom:1px solid var(--color-border-light);">
                            <td style="padding:var(--sp-4);">
                                <div style="display:flex;align-items:center;gap:var(--sp-3);">
                                    <div class="avatar avatar-sm" style="background:var(--color-primary);font-size:.75rem;">@aliasIni</div>
                                    <div>
                                        <div style="font-weight:600;">@cita.AliasUsuario</div>
                                        <div class="text-meta" style="font-size:.75rem;">Alias protegido</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding:var(--sp-4);"><span class="badge badge-info">@cita.Tipo</span></td>
                            <td style="padding:var(--sp-4);">
                                @cita.FechaHora.ToString("dd MMM yyyy")<br />
                                <small class="text-meta">@cita.FechaHora.ToString("h:mm tt")</small>
                            </td>
                            <td style="padding:var(--sp-4);">@cita.DuracionMinutos min</td>
                            <td style="padding:var(--sp-4);"><span class="badge @BadgeCita(cita.Estado)">@LabelCita(cita.Estado)</span></td>
                            <td style="padding:var(--sp-4);">
                                <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;">
                                    @if (vista == "proximas" && cita.Estado != EstadoCita.Cancelada)
                                    {
                                        <a asp-controller="Salas" asp-action="SalaPrivadaProfesional" asp-route-citaId="@cita.CitaId" class="btn btn-primary btn-sm">▶ Ingresar</a>
                                        <a asp-controller="Citas" asp-action="Detalle" asp-route-id="@cita.CitaId" class="btn btn-ghost btn-sm">Ver</a>
                                        <button type="button" class="btn btn-ghost btn-sm" style="color:var(--color-danger);"
                                                onclick="cancelarCita(@cita.CitaId, '@cita.AliasUsuario')">Cancelar</button>
                                    }
                                    else
                                    {
                                        <a asp-controller="Citas" asp-action="Detalle" asp-route-id="@cita.CitaId" class="btn btn-ghost btn-sm">Ver detalle</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Paginacion", pag)
    </div>
}

@section Scripts {
@Html.AntiForgeryToken()
<script>
function cancelarCita(citaId, paciente) {
  if (typeof showConfirm !== 'function') return;
  showConfirm({
    title: 'Cancelar cita',
    message: `¿Deseas cancelar la cita con ${paciente}? El paciente será notificado.`,
    confirmText: 'Cancelar cita',
    destructive: true,
    onConfirm: async () => {
      const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
      const res = await fetch('/Citas/Cancelar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `citaId=${citaId}&__RequestVerificationToken=${encodeURIComponent(token)}`
      });
      const d = await res.json();
      if (typeof showToast === 'function') showToast({ title: d.exito ? 'Cita cancelada' : 'Error', message: d.mensaje || '', type: d.exito ? 'success' : 'error' });
      if (d.exito) setTimeout(() => location.reload(), 800);
    }
  });
}
</script>
}
