@model Trebol.Model.Entities.TrebolEntities.Profesional
@using System.Globalization
@using Trebol.Model.DTOs.Profesional
@{
    ViewData["Title"] = "Mi perfil · Información personal";
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    var paises = ViewBag.Paises as IEnumerable<Trebol.Model.Entities.TrebolEntities.Pais> ?? [];
    var ciudades = ViewBag.Ciudades as IEnumerable<Trebol.Model.Entities.TrebolEntities.Ciudad> ?? [];
    var estudios = ViewBag.Estudios as IEnumerable<ProfesionalEstudioDto> ?? [];
    var especialidades = ViewBag.Especialidades as IEnumerable<string> ?? [];
    var idiomas = ViewBag.Idiomas as IEnumerable<string> ?? [];
    var docMask = string.IsNullOrEmpty(Model?.NumeroDocumento) ? "—"
        : Model.NumeroDocumento.Length > 4 ? "•••• " + Model.NumeroDocumento[^4..] : Model.NumeroDocumento;
    var ocupacionMostrar = Model?.Ocupacion;
    if (string.IsNullOrWhiteSpace(ocupacionMostrar) && !string.IsNullOrWhiteSpace(Model?.TipoProfesional))
    {
        ocupacionMostrar = Model.TipoProfesional switch
        {
            "Medico" => "Médico",
            "Psicologo" => "Psicólogo",
            _ => Model.TipoProfesional
        };
    }
    var tarifaMostrar = Model?.ValorPorHora.HasValue == true
        ? Model.ValorPorHora.Value.ToString(CultureInfo.InvariantCulture)
        : "";
}

@await Html.PartialAsync("_PerfilShell", Model)

<div style="background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--sp-8);box-shadow:var(--shadow-sm);border:1px solid var(--color-border-light);">
    <form asp-action="Actualizar" method="post" enctype="multipart/form-data" id="pro-info-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ProfesionalId" value="@Model?.ProfesionalId" />
        <input type="hidden" name="NombreCompleto" value="@Model?.NombreCompleto" />
        <div asp-validation-summary="All" class="form-error" style="margin-bottom:var(--sp-4);"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-5);margin-bottom:var(--sp-6);">
            <div class="form-group">
                <label class="form-label">País</label>
                <select name="PaisId" id="pais" class="form-control">
                    <option value="">Seleccionar...</option>
                    @foreach (var p in paises)
                    {
                        <option value="@p.PaisId" selected="@(Model?.PaisId == p.PaisId)">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Ciudad</label>
                <select name="CiudadId" id="ciudad" class="form-control">
                    <option value="">Seleccionar...</option>
                    @foreach (var c in ciudades)
                    {
                        <option value="@c.CiudadId" selected="@(Model?.CiudadId == c.CiudadId)">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Ocupación</label>
                <input name="Titulo" class="form-control" value="@ocupacionMostrar" />
            </div>
            <div class="form-group">
                <label class="form-label">Celular <span class="required">*</span></label>
                <input name="Celular" type="tel" class="form-control" value="@Model?.Celular" required />
            </div>
            <div class="form-group">
                <label class="form-label">Años de experiencia</label>
                <input name="AnosExperiencia" type="number" min="0" max="60" class="form-control" value="@Model?.AnosExperiencia" />
            </div>
            <div class="form-group">
                <label class="form-label">Tarifa por hora (COP)</label>
                <input name="TarifaCita" type="number" min="0" step="1000" class="form-control" value="@tarifaMostrar" />
            </div>
            @if (idiomas.Any())
            {
                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label">Idiomas</label>
                    <input class="form-control" value="@string.Join(", ", idiomas)" readonly style="background:var(--color-surface-alt);" />
                </div>
            }
            @if (especialidades.Any())
            {
                <div class="form-group" style="grid-column:1/-1;">
                    <label class="form-label">Especialidades / Áreas de atención</label>
                    <input class="form-control" value="@string.Join(", ", especialidades)" readonly style="background:var(--color-surface-alt);" />
                </div>
            }
            <div class="form-group" style="grid-column:1/-1;">
                <label class="form-label">Sobre mí</label>
                <textarea name="Descripcion" class="form-control" rows="4" style="resize:vertical;">@Model?.SobreMi</textarea>
            </div>
            <div class="form-group" style="grid-column:1/-1;">
                <label class="form-label">Foto de perfil</label>
                <input type="file" name="foto" id="foto-pro" class="form-control" accept="image/*" />
            </div>
        </div>

        @if (estudios.Any())
        {
            <div style="border-top:1px solid var(--color-border-light);padding-top:var(--sp-6);margin-bottom:var(--sp-6);">
                <h3 style="font-size:1rem;color:var(--color-primary);font-weight:700;margin-bottom:var(--sp-4);">📚 Formación académica</h3>
                <div style="display:flex;flex-direction:column;gap:var(--sp-3);">
                    @foreach (var est in estudios)
                    {
                        <div style="background:var(--color-surface-alt);border-radius:var(--radius-lg);padding:var(--sp-4);display:grid;grid-template-columns:120px 1fr 1fr;gap:var(--sp-3);align-items:center;">
                            <span class="badge badge-muted">@est.Nivel</span>
                            <div><strong>@est.Titulo</strong></div>
                            <div class="text-meta">@est.Universidad @(est.AnoEgreso.HasValue ? "· " + est.AnoEgreso : "")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div style="border-top:1px solid var(--color-border-light);padding-top:var(--sp-6);margin-bottom:var(--sp-6);">
            <h3 style="font-size:1rem;color:var(--color-primary);font-weight:700;margin-bottom:var(--sp-4);">🔒 Datos registrales (no editables)</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-4);">
                <div class="form-group">
                    <label class="form-label">Nombre completo</label>
                    <input type="text" class="form-control" value="@Model?.NombreCompleto" disabled style="background:var(--color-surface-alt);color:var(--color-text-muted);" />
                </div>
                <div class="form-group">
                    <label class="form-label">Correo electrónico</label>
                    <input type="email" class="form-control" value="@Model?.Correo" disabled style="background:var(--color-surface-alt);color:var(--color-text-muted);" />
                </div>
                <div class="form-group">
                    <label class="form-label">N.° cédula</label>
                    <input type="text" class="form-control" value="@docMask" disabled style="background:var(--color-surface-alt);color:var(--color-text-muted);" />
                </div>
                <div class="form-group">
                    <label class="form-label">Tarjeta profesional</label>
                    <input type="text" class="form-control" value="@Model?.NumerTarjetaProfesional" disabled style="background:var(--color-surface-alt);color:var(--color-text-muted);" />
                </div>
            </div>
        </div>

        <div style="display:flex;gap:var(--sp-3);">
            <button type="submit" class="btn btn-primary"><span class="btn-text">Guardar cambios</span></button>
            <button type="button" class="btn btn-secondary" onclick="location.reload()">Cancelar</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.getElementById('pais')?.addEventListener('change', async function() {
  const paisId = this.value;
  const sel = document.getElementById('ciudad');
  if (!paisId) { sel.innerHTML = '<option value="">Seleccionar...</option>'; return; }
  const res = await fetch('/PerfilProfesional/CiudadesPorPais?paisId=' + encodeURIComponent(paisId));
  const data = await res.json();
  sel.innerHTML = '<option value="">Seleccionar...</option>';
  data.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c.ciudadId; opt.textContent = c.nombre;
    sel.appendChild(opt);
  });
});
document.getElementById('foto-pro')?.addEventListener('change', function() {
  if (!this.files?.length) return;
  const reader = new FileReader();
  reader.onload = e => {
    const av = document.getElementById('pro-avatar');
    if (!av) return;
    if (av.tagName === 'IMG') { av.src = e.target.result; }
    else {
      av.style.backgroundImage = `url(${e.target.result})`;
      av.style.backgroundSize = 'cover';
      av.textContent = '';
    }
  };
  reader.readAsDataURL(this.files[0]);
});
</script>
}
