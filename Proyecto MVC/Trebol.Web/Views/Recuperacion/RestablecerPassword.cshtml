@model Trebol.Web.ViewModels.Auth.RestablecerPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

@section Styles {
<style>
body { background: var(--color-surface); }
.public-nav, footer { display: none; }
</style>
}

<div class="auth-layout">

    <div class="auth-panel auth-panel--left" aria-hidden="true">
        <div class="auth-illustration">
            <div class="auth-illustration__tag">🔒 Nueva contraseña</div>
            <h1 class="auth-illustration__title">
                Crea una<br>contraseña<br><em>segura</em>
            </h1>
            <p class="auth-illustration__text">
                Elige una contraseña nueva y segura para tu cuenta. Asegúrate de recordarla o guardarla en un lugar seguro.
            </p>
        </div>
    </div>

    <div class="auth-panel auth-panel--right">
        <div class="auth-form">

            <a asp-controller="Landing" asp-action="Index" class="auth-form__logo">
                <div class="auth-form__logo-icon">🍀</div>
                <span class="auth-form__logo-name">Trébol</span>
            </a>

            <h2 class="auth-form__title">Nueva contraseña</h2>
            <p class="auth-form__subtitle">Crea una contraseña nueva para tu cuenta.</p>

            <form asp-action="RestablecerPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="form-error" style="margin-bottom:var(--sp-4);"></div>
                <input type="hidden" asp-for="Token" />

                <div class="form-group">
                    <label asp-for="NuevoPassword" class="form-label">
                        Nueva contraseña <span class="required" aria-hidden="true">*</span>
                    </label>
                    <div class="input-wrapper">
                        <input asp-for="NuevoPassword" type="password" class="form-control"
                               placeholder="Mínimo 8 caracteres"
                               autocomplete="new-password" aria-required="true" />
                        <button type="button" class="input-toggle" onclick="this.previousElementSibling.type=this.previousElementSibling.type==='password'?'text':'password'" aria-label="Mostrar">👁</button>
                    </div>
                    <span asp-validation-for="NuevoPassword" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmarPassword" class="form-label">
                        Confirmar contraseña <span class="required" aria-hidden="true">*</span>
                    </label>
                    <div class="input-wrapper">
                        <input asp-for="ConfirmarPassword" type="password" class="form-control"
                               placeholder="Repite tu contraseña"
                               autocomplete="new-password" aria-required="true" />
                        <button type="button" class="input-toggle" onclick="this.previousElementSibling.type=this.previousElementSibling.type==='password'?'text':'password'" aria-label="Mostrar">👁</button>
                    </div>
                    <span asp-validation-for="ConfirmarPassword" class="form-error"></span>
                </div>

                <button type="submit" class="btn btn-primary w-full">
                    <span class="btn-text">Restablecer contraseña</span>
                </button>
            </form>

            <div class="auth-footer-link" style="margin-top:var(--sp-5);">
                <a asp-controller="Login" asp-action="Index" style="color:var(--color-text-muted);font-size:.8125rem;">← Volver al login</a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
